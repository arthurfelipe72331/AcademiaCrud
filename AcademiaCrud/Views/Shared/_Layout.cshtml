<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcademiaCrud</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcademiaCrud.styles.css" asp-append-version="true" />
    <link href="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.css" rel="stylesheet" integrity="sha384-1z3BkqkX8Kh4v3qQlL2xEzxIMj8RupOgGJh4x7NQUolysp8oGApx7DKpP7xW0Ynh" crossorigin="anonymous">
   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
      
        body {
            background-image: url('/assets/images.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

   

       
        footer {
            background-color: rgba(33, 37, 41, 0.95);
            color: #fff;
            border-top: 3px solid #ff5722;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold text-uppercase"
                   asp-controller="Home"
                   asp-action="Index">
                    <span style="color: #ff5722;">Academia</span>Crud
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Instrutor"
                               asp-action="Index">
                                Instrutores
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

   
    <main class="container mt-4 mb-4 conteudo-principal">
        @RenderBody()
    </main>

    <footer class="text-center py-3 mt-auto">
        <p class="mb-0">
            &copy; 2026 - AcademiaCrud
        </p>
    </footer>

  
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.js" integrity="sha384-4KvBx+ygRyZ/XBcprEmKhIFo1BLD5rDlrEQvevVh0Rw32ZXTvv6RzbWTkTyzvJYK" crossorigin="anonymous"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>