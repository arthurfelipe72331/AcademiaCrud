@model AcademiaCrud.Models.Instrutor

@{
    ViewData["Title"] = "Delete";
}

<div class="text-white">
    <h1>Deletar</h1>

    <h3>Voce tem certeza que quer isto??</h3>
    <div>
        <h4>Instrutor</h4>
        <hr class="border-light" />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.nome)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.nome)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.email)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.email)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.telefone)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.telefone)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.sexo)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.sexo)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.idade)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.idade)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="idInstrutor" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>